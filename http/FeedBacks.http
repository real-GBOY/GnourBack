@host = http://localhost:4005/api/feedback
@feedbackId = 68929fa4e5238dcb4c033c00
@userId = 68915d9d3ba05099590afcdd
@taskId = 68929f44e5238dcb4c033bf1
@meetingId = 6892971f03d29009b2b0f372
@attendanceId = 68915d9d3ba05099590afcdd

### Create Feedback - Task Related
POST {{host}}/
Content-Type: application/json

{
  "title": "Task Completion Feedback",
  "content": "The task was completed successfully with good attention to detail. The team member showed excellent problem-solving skills.",
  "category": "task",
  "submittedBy": "{{userId}}",
  "taskId": "{{taskId}}"
}
