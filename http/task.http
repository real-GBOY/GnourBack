@host = http://localhost:4005

@id = 68929f44e5238dcb4c033bf1
### 1. Create Task with File Upload
POST {{host}}/api/tasks
Content-Type: multipart/form-data; boundary=----GnourTaskBoundary

# ! Create Task with File Upload Response
# {
#   "success": true,
#   "message": "Task created successfully with file",
#   "data": {
#     "_id": "689364861f511e23969424b1",
