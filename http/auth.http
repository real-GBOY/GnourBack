### Login with Invalid Credentials
POST {{host}}/login
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "wrongpassword"
}



### Refresh Token
POST {{host}}/refresh
Content-Type: application/json

{
  "refreshToken": "your-refresh-token-here"
}

# ! Refresh Token Response
# {
#   "success": true,
#   "message": "Token refreshed successfully",
#   "data": {
#     "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
#     "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
#   }
# }

### Refresh Token with Invalid Token
POST {{host}}/refresh
Content-Type: application/json

{
  "refreshToken": "invalid-refresh-token"
}

### Logout
POST {{host}}/logout
Content-Type: application/json

{
  "refreshToken": "your-refresh-token-here"
}

# ! Logout Response
# {
#   "success": true,
#   "message": "Logged out successfully"
# }

### Logout without Token
POST {{host}}/logout
Content-Type: application/json

{
  "refreshToken": ""
}

### Get Profile by ID
GET {{host}}/profile/{{id}}
Authorization: Bearer {{token}}

### Get Profile with "me" parameter
GET {{host}}/profile/me
Authorization: Bearer {{token}}

### Get Profile with Invalid ID
GET {{host}}/profile/invalid-id
Authorization: Bearer {{token}}

### Get Profile without ID
GET {{host}}/profile/
Authorization: Bearer {{token}}

### Get Profile without Authorization (should fail)
GET {{host}}/profile/me

### Change Password
PUT {{host}}/profile/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "oldpassword",
  "newPassword": "newpassword123"
}

### Change Password with Wrong Current Password
PUT {{host}}/profile/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "wrongpassword",
  "newPassword": "newpassword123"
}

### Change Password Missing Fields
PUT {{host}}/profile/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "oldpassword"
}



