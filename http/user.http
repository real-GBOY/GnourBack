#       "key": "President",
#       "permissions": [...]
#     }
#   }
# }

### Verify User with Invalid ID
PATCH {{host}}/verify/invalid-id
Content-Type: application/json

{
  "isVerified": true
}

### Assign Role with Invalid User ID
PATCH {{host}}/assign-role/invalid-id
Content-Type: application/json

{
  "roleId": "{{roleId}}"
} 

### Update Profile with Photo Upload
PUT http://localhost:4005/api/auth/profile
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="firstName"

John
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="lastName"

Doe
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="phoneNumber"

+1234567890
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="dateOfBirth"

1990-01-01
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="profile-photo.jpg"
Content-Type: image/jpeg

< ./test-image.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Update Profile without Photo Upload
PUT http://localhost:4005/api/auth/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "phoneNumber": "+1234567890",
  "dateOfBirth": "1990-01-01"
}

### Get My Profile
GET http://localhost:4005/api/auth/profile
Authorization: Bearer {{token}}

### Get Profile by ID
GET http://localhost:4005/api/auth/profile/me
Authorization: Bearer {{token}} 

### Get team members for a specific team (requires ViewTeamMembers permission - Members can use this)
GET {{host}}/team/{{teamId}}/members
{{authHeader}}

### Get all teams with their members (requires ViewTeamMembers permission - Members can use this)
GET {{host}}/teams/with-members
{{authHeader}}

### Update User (self, team board, or President can edit)
PUT {{host}}/{{userId}}
{{authHeader}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Updated",
  "phoneNumber": "+201234567890",
  "dateOfBirth": "1990-01-01"
}

