### Verify User
PATCH {{host}}/verify/{{userId}}
Content-Type: application/json

{
  "isVerified": true,
  "role": "{{roleId}}"
}

# ! Verify User Response
# {
#   "success": true,
#   "message": "User verified successfully",
#   "data": {
#     "_id": "68915d9d3ba05099590afcdd",
#     "firstName": "John",
#     "lastName": "Doe",
#     "email": "jon.doe@example.com",
#     "isVerified": true,
#     "role": {
#       "_id": "68915d47342eba8c616b7b58",
#       "key": "President",
#       "permissions": [...]
#     }
#   }
# }

### Verify User (Only Verification Status)
PATCH {{host}}/verify/{{userId}}
Content-Type: application/json

{
  "isVerified": true
}

### Assign Role to User
PATCH {{host}}/assign-role/{{userId}}
Content-Type: application/json

{
  "roleId": "{{roleId}}"
}

# ! Assign Role Response
# {
#   "success": true,
#   "message": "Role assigned successfully",
